# ==============================================
# Jess Enterprises - Environment Variables
# ==============================================

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# MongoDB Connection (MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jess_enterprises?retryWrites=true&w=majority

# NextAuth (Auth.js v5) Configuration
AUTH_SECRET=generate_a_random_32_character_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Cloudinary (Image & PDF storage)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Service (Resend or SMTP fallback)
RESEND_API_KEY=re_123456789
EMAIL_FROM=Jess Enterprises <noreply@jessenterprisesgoa.com>
BUSINESS_NOTIFICATION_EMAIL=jess.enterprises14@gmail.com

# Optional SMTP Fallback (if not using Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudflare Turnstile (Spam protection on public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Initial Admin User Setup (used by scripts/seed.ts)
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_EMAIL=jess.enterprises14@gmail.com
INITIAL_ADMIN_PASSWORD=ChangeThisPassword123!
